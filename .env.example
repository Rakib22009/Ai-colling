# GEMINI_API_KEY: Required for server-side Gemini Live API, transcription, TTS, and intelligence calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, Web Push notification URLs, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL TURN/STUN CONFIGURATION FOR STRICT NAT NETWORKS
# Public Google STUN servers are enabled by default; set custom ICE servers if needed in production.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
